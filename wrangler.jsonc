{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "reframe",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
